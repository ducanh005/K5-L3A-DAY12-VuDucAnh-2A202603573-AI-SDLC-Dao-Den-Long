{
  "name": "dao-den-long",
  "version": "0.2.0-phase1",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D third-person game with Test Contract v1.0 headless simulation (Day 12 AI SDLC)",
  "scripts": {
    "dev": "vite",
    "build:headless": "esbuild src/headless/cli.ts --bundle --platform=node --format=esm --outfile=dist-headless/cli.js",
    "build": "tsc --noEmit && vite build && npm run build:headless",
    "preview": "vite preview",
    "test": "vitest run",
    "headless": "node dist-headless/cli.js",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
