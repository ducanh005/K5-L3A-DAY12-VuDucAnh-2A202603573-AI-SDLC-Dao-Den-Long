{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D third-person game across 3 islands with Test Contract v1.3, benchmark, soak test & Release v1.0.0",
  "scripts": {
    "dev": "vite",
    "build:headless": "esbuild src/headless/cli.ts --bundle --platform=node --format=esm --outfile=dist-headless/cli.js && esbuild src/core/world.ts --bundle --platform=node --format=esm --outfile=dist-headless/core.js",
    "build": "tsc --noEmit && vite build && npm run build:headless",
    "preview": "vite preview",
    "test": "vitest run",
    "headless": "node dist-headless/cli.js",
    "bench": "node scripts/bench.mjs",
    "soak": "node --max-semi-space-size=1 scripts/soak.mjs",
    "export-leaderboard": "node scripts/run.mjs --export-leaderboard",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
